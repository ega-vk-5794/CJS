*---------------------------------------------------------------------*
FORM CORR_MAINT_ZMV_JNY_OPT USING VALUE(CM_ACTION) RC.
  DATA: RETCODE LIKE SY-SUBRC, COUNT TYPE I, TRSP_KEYLEN TYPE SYFLENG.
  FIELD-SYMBOLS: <TAB_KEY_X> TYPE X.
  CLEAR RC.
MOVE ZMV_JNY_OPT-JOURNEY_ID TO
ZRAK_T_JNY_OPT-JOURNEY_ID .
MOVE ZMV_JNY_OPT-STEP_ID TO
ZRAK_T_JNY_OPT-STEP_ID .
MOVE ZMV_JNY_OPT-FIELD_NAME TO
ZRAK_T_JNY_OPT-FIELD_NAME .
MOVE ZMV_JNY_OPT-OPT_KEY TO
ZRAK_T_JNY_OPT-OPT_KEY .
MOVE ZMV_JNY_OPT-MANDT TO
ZRAK_T_JNY_OPT-MANDT .
  CORR_KEYTAB             =  E071K.
  CORR_KEYTAB-OBJNAME     = 'ZRAK_T_JNY_OPT'.
  IF NOT <vim_corr_keyx> IS ASSIGNED.
    ASSIGN CORR_KEYTAB-TABKEY TO <vim_corr_keyx> CASTING.
  ENDIF.
  ASSIGN ZRAK_T_JNY_OPT TO <TAB_KEY_X> CASTING.
  PERFORM VIM_GET_TRSPKEYLEN
    USING 'ZRAK_T_JNY_OPT'
    CHANGING TRSP_KEYLEN.
  <VIM_CORR_KEYX>(TRSP_KEYLEN) = <TAB_KEY_X>(TRSP_KEYLEN).
  PERFORM UPDATE_CORR_KEYTAB USING CM_ACTION RETCODE.
  ADD: RETCODE TO RC, 1 TO COUNT.
  IF RC LT COUNT AND CM_ACTION NE PRUEFEN.
    CLEAR RC.
  ENDIF.

ENDFORM.
