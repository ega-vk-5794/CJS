*---------------------------------------------------------------------*
*    view related FORM routines
*---------------------------------------------------------------------*
*...processing: ZMV_JNY_OPT.....................................*
FORM GET_DATA_ZMV_JNY_OPT.
  PERFORM VIM_FILL_WHERETAB.
*.read data from database.............................................*
  REFRESH TOTAL.
  CLEAR   TOTAL.
  SELECT * FROM ZRAK_T_JNY_OPT WHERE
(VIM_WHERETAB) .
    CLEAR ZMV_JNY_OPT .
ZMV_JNY_OPT-MANDT =
ZRAK_T_JNY_OPT-MANDT .
ZMV_JNY_OPT-JOURNEY_ID =
ZRAK_T_JNY_OPT-JOURNEY_ID .
ZMV_JNY_OPT-STEP_ID =
ZRAK_T_JNY_OPT-STEP_ID .
ZMV_JNY_OPT-FIELD_NAME =
ZRAK_T_JNY_OPT-FIELD_NAME .
ZMV_JNY_OPT-OPT_KEY =
ZRAK_T_JNY_OPT-OPT_KEY .
ZMV_JNY_OPT-SEQNR =
ZRAK_T_JNY_OPT-SEQNR .
ZMV_JNY_OPT-OPT_TEXT =
ZRAK_T_JNY_OPT-OPT_TEXT .
ZMV_JNY_OPT-OPT_TEXT_AR =
ZRAK_T_JNY_OPT-OPT_TEXT_AR .
    SELECT SINGLE * FROM ZRAK_T_JNY_FLD WHERE
JOURNEY_ID = ZRAK_T_JNY_OPT-JOURNEY_ID AND
STEP_ID = ZRAK_T_JNY_OPT-STEP_ID AND
FIELD_NAME = ZRAK_T_JNY_OPT-FIELD_NAME .
    IF SY-SUBRC EQ 0.
    ENDIF.
<VIM_TOTAL_STRUC> = ZMV_JNY_OPT.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_ZMV_JNY_OPT .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO ZMV_JNY_OPT.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_ZMV_JNY_OPT-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM ZRAK_T_JNY_OPT WHERE
  JOURNEY_ID = ZMV_JNY_OPT-JOURNEY_ID AND
  STEP_ID = ZMV_JNY_OPT-STEP_ID AND
  FIELD_NAME = ZMV_JNY_OPT-FIELD_NAME AND
  OPT_KEY = ZMV_JNY_OPT-OPT_KEY .
    IF SY-SUBRC = 0.
    DELETE ZRAK_T_JNY_OPT .
    ENDIF.
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM ZRAK_T_JNY_OPT WHERE
  JOURNEY_ID = ZMV_JNY_OPT-JOURNEY_ID AND
  STEP_ID = ZMV_JNY_OPT-STEP_ID AND
  FIELD_NAME = ZMV_JNY_OPT-FIELD_NAME AND
  OPT_KEY = ZMV_JNY_OPT-OPT_KEY .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR ZRAK_T_JNY_OPT.
    ENDIF.
ZRAK_T_JNY_OPT-MANDT =
ZMV_JNY_OPT-MANDT .
ZRAK_T_JNY_OPT-JOURNEY_ID =
ZMV_JNY_OPT-JOURNEY_ID .
ZRAK_T_JNY_OPT-STEP_ID =
ZMV_JNY_OPT-STEP_ID .
ZRAK_T_JNY_OPT-FIELD_NAME =
ZMV_JNY_OPT-FIELD_NAME .
ZRAK_T_JNY_OPT-OPT_KEY =
ZMV_JNY_OPT-OPT_KEY .
ZRAK_T_JNY_OPT-SEQNR =
ZMV_JNY_OPT-SEQNR .
ZRAK_T_JNY_OPT-OPT_TEXT =
ZMV_JNY_OPT-OPT_TEXT .
ZRAK_T_JNY_OPT-OPT_TEXT_AR =
ZMV_JNY_OPT-OPT_TEXT_AR .
    IF SY-SUBRC = 0.
    UPDATE ZRAK_T_JNY_OPT ##WARN_OK.
    ELSE.
    INSERT ZRAK_T_JNY_OPT .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_ZMV_JNY_OPT-UPD_FLAG,
STATUS_ZMV_JNY_OPT-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
