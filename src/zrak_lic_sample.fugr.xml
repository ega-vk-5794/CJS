  <asx:values>
   <AREAT>RAK CJS - license sample utilities</AREAT>
   <INCLUDES>
    <SOBJ_NAME>LZRAK_LIC_SAMPLETOP</SOBJ_NAME>
    <SOBJ_NAME>SAPLZRAK_LIC_SAMPLE</SOBJ_NAME>
   </INCLUDES>
   <FUNCTIONS>
    <item>
     <FUNCNAME>Z_RAK_LIC_VALIDATE_SHARES</FUNCNAME>
     <SHORT_TEXT>Validate shareholder ownership totals 100%</SHORT_TEXT>
     <IMPORT>
      <RSIMP>
       <PARAMETER>IV_PERCENTAGES</PARAMETER>
       <TYP>STRING</TYP>
      </RSIMP>
     </IMPORT>
     <EXPORT>
      <RSEXP>
       <PARAMETER>EV_TOTAL</PARAMETER>
       <TYP>STRING</TYP>
      </RSEXP>
      <RSEXP>
       <PARAMETER>EV_VALID</PARAMETER>
       <TYP>ABAP_BOOL</TYP>
      </RSEXP>
     </EXPORT>
     <DOCUMENTATION>
      <RSFDO>
       <PARAMETER>IV_PERCENTAGES</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Comma-separated shareholder percentages, e.g. 40,30,30</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>EV_TOTAL</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Sum of the percentages</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>EV_VALID</PARAMETER>
       <KIND>P</KIND>
       <STEXT>X if the total equals 100</STEXT>
      </RSFDO>
     </DOCUMENTATION>
    </item>
   </FUNCTIONS>
